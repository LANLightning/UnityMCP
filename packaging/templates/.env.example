# unity-mcp-py — 本地化环境变量。复制为 .env 并填值，或直接写进 MCP 客户端的 env 块。
# 详见 DEPLOY.md「本地化待填清单」。

# [必填] Unity 工程根目录 (open_scene / ensure_ready 的路径校验锚点)
UNITY_MCP_PROJECT_PATH=<UNITY_PROJECT_ROOT>

# [可选] auto_login 测试账号 (仅当你使用 auto_login 工具时需要)
# UNITY_MCP_LOGIN_USERNAME=<LOGIN_USERNAME>
# UNITY_MCP_LOGIN_SERVER_ID=<LOGIN_SERVER_ID>
# UNITY_MCP_LOGIN_SCENE_ID=<LOGIN_SCENE_ID>

# [可选] 桥连接 (默认 127.0.0.1:17873；非默认才填)
# UNITY_MCP_BRIDGE_HOST=127.0.0.1
# UNITY_MCP_BRIDGE_PORT=17873

# [可选/进阶] 协议 schema 路径。新设备留空即可 (握手自动降级到内置版本)。
# 仅旧开发机想指回本地 schema 时填。
# UNITY_MCP_SCHEMA_PATH=<PATH_TO_protocol.schema.json>
